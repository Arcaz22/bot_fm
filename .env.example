APP_ENV=production
APP_DEBUG=false
APP_PORT=8000

DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=sarekat_db

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=moondream
OLLAMA_TIMEOUT_SECONDS=120
LLM_PROVIDER=ollama

FINANCE_TELEGRAM_TOKEN=replace-with-telegram-token
FINANCE_GOOGLE_API_KEY=replace-with-google-api-key
