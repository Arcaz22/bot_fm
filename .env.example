FINANCE_DEFAULT_FREE_PLAN_CODE=free
FINANCE_TELEGRAM_QUEUE_WORKERS=2
FINANCE_TELEGRAM_UPDATE_DEDUPE_TTL_SECONDS=604800
FINANCE_TELEGRAM_USER_QUEUE_LOCK_TTL_SECONDS=300

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
